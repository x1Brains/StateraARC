{
  "functions": {
    "api/holdings.js": {
      "maxDuration": 120
    },
    "api/snapshot.js": {
      "maxDuration": 30
    },
    "api/v2.js": {
      "maxDuration": 30
    },
    "api/report.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/v2/:path*",
      "destination": "/api/v2?path=:path*"
    },
    {
      "source": "/api/xdex/:path*",
      "destination": "https://api.xdex.xyz/:path*"
    },
    {
      "source": "/api/warp/:path*",
      "destination": "https://warp-arc-production.up.railway.app/api/:path*"
    },
    {
      "source": "/api/radar/:path*",
      "destination": "/api/radar?path=:path*"
    },
    {
      "source": "/api/logo/:addr",
      "destination": "/api/logo?addr=:addr"
    },
    {
      "source": "/token/:addr",
      "destination": "/api/token?addr=:addr"
    },
    {
      "source": "/network",
      "destination": "/api/network-page"
    },
    {
      "source": "/((?!api/|assets/|coins/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
