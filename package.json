{
  "name": "statera",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "StateraArc \u2014 token screener for Circle's Arc chain",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:api && tsc && vite build",
    "preview": "vite preview",
    "check:api": "for f in api/*.js lib/*.js; do node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "lightweight-charts": "^4.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
