# /etc/systemd/system/statera-swaps.service — the permanent swap store (server/swap-indexer.ts → /root/statera-swaps/swaps.db).
# Read by statera-api (server/swap-store.ts) for the chart, trade history and wallet trades. Runs from /root/statera-swaps/app,
# which server/deploy-swaps.sh fills from the API clone — so the v1 timers' git reset never swaps code under it.
# Small caps: this box runs the real-money bots; the indexer is tiny (one SQLite connection, ≤20k logs in flight).
[Unit]
Description=StateraArc swap indexer (every USDC-pool swap on Arc, kept in SQLite for charts + P&L)
After=network-online.target

[Service]
WorkingDirectory=/root/statera-swaps/app
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning --max-old-space-size=220 server/swap-indexer.ts
Restart=always
RestartSec=10
Nice=10
MemoryMax=300M
Environment=NODE_ENV=production
Environment=SWAPS_DB=/root/statera-swaps/swaps.db

[Install]
WantedBy=multi-user.target
