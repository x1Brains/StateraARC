# /etc/systemd/system/statera-api.service — the v2 data API (see server/statera-api.ts, docs/UPGRADE_PLAN.md).
# Runs from its OWN clone (/root/statera-api-repo) so the v1 timers' `git reset` of /root/statera-repo never swaps code
# under it; server/deploy-api.sh updates it deliberately. MemoryMax keeps it from ever starving the other services on this box.
# 09-28: 300M OOM-killed it 5× (chart pre-builds); 700M cap, and V8's heap capped just under it so it GCs before the kill.
[Unit]
Description=StateraArc v2 data API (board/home/search/token, live re-price once for all visitors)
After=network-online.target

[Service]
WorkingDirectory=/root/statera-api-repo
# 10-24: heap cap 400 (was 600) — the heap idles ~170 MB but V8 let it grow lazily toward 600 while the 3 swap workers + SQLite use ~250 MB
# more, so the 9 MB snapshot reload pushed the cgroup past 700M (OOM-killed ~5 min after snapshot runs, 10-23 23:07 + 10-24 03:05)
# 10-26: heap cap 300. Swap workers stop after 60 s idle (server/swap-worker.ts), yet 2 big token pages at once (sandbox: 3 big
# tokens ≈ +280 MB of worker memory) on a ~450 MB main process still crossed 700M (kills 21:21 + 21:35) → MemoryMax 900M.
# Box had ~880 MB available at the time; the cap still keeps this service from taking more.
ExecStart=/usr/bin/node --max-old-space-size=300 server/statera-api.ts
Restart=always
RestartSec=5
Nice=5
MemoryMax=900M
Environment=NODE_ENV=production
# 10-29: RSS crept to the 900M cap though the JS heap stayed ~180M — the swap workers start/stop (idle-stop, 53 cycles a day)
# and each thread got its own glibc malloc arena that kept its freed memory (10 stranded arenas + a 144M fragmented main heap
# in /proc/PID/smaps). 2 arenas max + trim freed memory back to the OS.
Environment=MALLOC_ARENA_MAX=2
Environment=MALLOC_TRIM_THRESHOLD_=131072

[Install]
WantedBy=multi-user.target
