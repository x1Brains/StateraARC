# /etc/systemd/system/statera-api.service — the v2 data API (see server/statera-api.ts, docs/UPGRADE_PLAN.md).
# Runs from its OWN clone (/root/statera-api-repo) so the v1 timers' `git reset` of /root/statera-repo never swaps code
# under it; server/deploy-api.sh updates it deliberately. MemoryMax keeps it from ever starving the other services on this box.
# 09-28: 300M OOM-killed it 5× (chart pre-builds); 700M cap, and V8's heap capped just under it so it GCs before the kill.
[Unit]
Description=StateraArc v2 data API (board/home/search/token, live re-price once for all visitors)
After=network-online.target

[Service]
WorkingDirectory=/root/statera-api-repo
# 10-24: heap cap 400 (was 600) — the heap idles ~170 MB but V8 let it grow lazily toward 600 while the 3 swap workers + SQLite use ~250 MB
# more, so the 9 MB snapshot reload pushed the cgroup past 700M (OOM-killed ~5 min after snapshot runs, 10-23 23:07 + 10-24 03:05)
ExecStart=/usr/bin/node --max-old-space-size=400 server/statera-api.ts
Restart=always
RestartSec=5
Nice=5
MemoryMax=700M
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
